            "armToolchainPath": "C:\\Users\\33127\\AppData\\Local\\stm32cube\\bundles\\gnu-tools-for-stm32\\14.3.1+st.2\\bin",
            "gdbPath": "C:\\Users\\33127\\AppData\\Local\\stm32cube\\bundles\\gnu-tools-for-stm32\\14.3.1+st.2\\bin\\arm-none-eabi-gdb.exe",
            
            "preLaunchCommands": [
                "monitor reset halt"          
            ],
            
            "showDevDebugOutput": "raw"
        }
